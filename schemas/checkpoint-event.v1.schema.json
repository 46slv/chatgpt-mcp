{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://46slv.example/schemas/checkpoint-event.v1.schema.json",
  "title": "EPHEMERA Checkpoint Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol","schema_version","mission_id","sequence","created_at","producer","workspace","mode","semantic","observed_state","evidence_refs","report_target","checkpoint_id","report_id"],
  "properties": {
    "protocol": {"const":"ephemera.checkpoint-event"},
    "schema_version": {"const":1},
    "mission_id": {"type":"string","minLength":1,"maxLength":256},
    "sequence": {"type":"integer","minimum":1},
    "created_at": {"type":"string","format":"date-time"},
    "producer": {
      "type":"object","additionalProperties":false,"required":["kind","session_id"],
      "properties":{"kind":{"type":"string","enum":["codex","ephemera","local-worker"]},"session_id":{"type":["string","null"]}}
    },
    "workspace": {"type":"string","minLength":1},
    "goal": {"type":["string","null"]},
    "mode": {"type":"string","enum":["REPORT","CONSULT"]},
    "semantic": {
      "type":"object","additionalProperties":false,"required":["next","approach","done_for_next","question"],
      "properties":{
        "next":{"type":"string","minLength":1,"maxLength":4000},
        "approach":{"type":"string","minLength":1,"maxLength":6000},
        "done_for_next":{"type":["string","null"],"maxLength":3000},
        "question":{"type":["string","null"],"maxLength":4000}
      }
    },
    "observed_state":{"type":"object"},
    "evidence_refs":{"type":"array","maxItems":32,"items":{"type":"string","maxLength":1000}},
    "report_target":{
      "type":"object","additionalProperties":false,"required":["target_id","chat_url","conversation_id"],
      "properties":{"target_id":{"type":"string"},"chat_url":{"type":"string"},"conversation_id":{"type":"string"}}
    },
    "checkpoint_id":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "report_id":{"type":"string","pattern":"^report-[a-f0-9]{24}$"}
  },
  "allOf":[
    {"if":{"properties":{"mode":{"const":"CONSULT"}}},"then":{"properties":{"semantic":{"properties":{"question":{"type":"string","minLength":1}}}}}}
  ]
}
