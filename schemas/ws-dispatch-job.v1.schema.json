{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://46slv.example/schemas/ws-dispatch-job.v1.schema.json",
  "title": "WS Dispatch Job v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol","schema_version","job_id","workspace","lane","authority","goal","done","reply","created_at"],
  "properties": {
    "protocol": {"const": "ws-dispatch.job"},
    "schema_version": {"const": 1},
    "job_id": {"type":"string","pattern":"^[A-Za-z0-9._-]{1,128}$"},
    "workspace": {"type":"string","minLength":1,"maxLength":4096},
    "lane": {"type":"string","enum":["muse","codex-luna","auto"]},
    "authority": {"type":"string","enum":["read-only","workspace-write"]},
    "goal": {"type":"string","minLength":1,"maxLength":16000},
    "done": {"type":"string","minLength":1,"maxLength":12000},
    "reply": {
      "type":"object",
      "additionalProperties":false,
      "required":["mode","target_alias"],
      "properties": {
        "mode":{"type":"string","enum":["NONE","REPORT","CONSULT"]},
        "target_alias":{"type":["string","null"],"minLength":1,"maxLength":256}
      }
    },
    "created_at":{"type":"string","format":"date-time"}
  }
}
