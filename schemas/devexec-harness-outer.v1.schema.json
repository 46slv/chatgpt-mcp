{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devexec.harness-outer.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "outer_run_id", "goal_identity", "task_identity", "project_adapter", "max_cycles", "status", "created_at", "updated_at", "harness_binding", "pending_cycle", "cycles"],
  "properties": {
    "schema": {"const": "devexec.harness-outer.v1"},
    "outer_run_id": {"type": "string", "minLength": 1},
    "goal_identity": {"type": "string", "minLength": 1},
    "task_identity": {"type": "string", "minLength": 1},
    "project_adapter": {"type": "string", "minLength": 1},
    "max_cycles": {"type": "integer", "minimum": 1, "maximum": 64},
    "status": {"enum": ["RUNNING", "COMPLETE", "NEEDS_HUMAN"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "harness_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness_repository", "harness_commit_sha", "target_repository", "target_ref", "target_base_sha", "working_directory", "evidence_root"],
      "properties": {
        "harness_repository": {"type": "string", "minLength": 1},
        "harness_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "target_repository": {"type": "string", "minLength": 1},
        "target_ref": {"type": "string", "minLength": 1},
        "target_base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "working_directory": {"type": "string", "minLength": 1},
        "evidence_root": {"type": "string", "minLength": 1}
      }
    },
    "pending_cycle": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["cycle_index", "child_run_id", "harness_repository", "harness_commit_sha", "target_repository", "target_ref", "target_base_sha", "working_directory", "evidence_root", "project_adapter", "input_state_hash", "task_id", "goal_id", "started_at"],
          "properties": {
            "cycle_index": {"type": "integer", "minimum": 0, "maximum": 63},
            "child_run_id": {"type": "string", "minLength": 1},
            "harness_repository": {"type": "string", "minLength": 1},
            "harness_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "target_repository": {"type": "string", "minLength": 1},
            "target_ref": {"type": "string", "minLength": 1},
            "target_base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "working_directory": {"type": "string", "minLength": 1},
            "evidence_root": {"type": "string", "minLength": 1},
            "project_adapter": {"type": "string", "minLength": 1},
            "input_state_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "task_id": {"type": "string", "minLength": 1},
            "goal_id": {"type": "string", "minLength": 1},
            "started_at": {"type": "string", "format": "date-time"}
          }
        }
      ]
    },
    "cycles": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cycle_index", "child_run_id", "harness_commit_sha", "target_base_sha", "input_state_hash", "resulting_state_hash", "cycle_evidence_path", "cycle_evidence_hash", "task_id", "goal_id", "fast_path_eligible", "skipped_roles", "launched_roles", "runner_status", "verifier_status", "next_action", "started_at", "completed_at", "ephemeral", "transcripts_forwarded"],
        "properties": {
          "cycle_index": {"type": "integer", "minimum": 0, "maximum": 63},
          "child_run_id": {"type": "string", "minLength": 1},
          "harness_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "target_base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "input_state_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "resulting_state_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "cycle_evidence_path": {"type": ["string", "null"]},
          "cycle_evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "task_id": {"type": "string", "minLength": 1},
          "goal_id": {"type": "string", "minLength": 1},
          "fast_path_eligible": {"type": "boolean"},
          "skipped_roles": {"type": "array", "items": {"type": "string"}},
          "launched_roles": {"type": "array", "items": {"type": "string"}},
          "runner_status": {"type": ["string", "null"]},
          "verifier_status": {"type": ["string", "null"]},
          "next_action": {"type": "string", "minLength": 1},
          "started_at": {"type": "string", "format": "date-time"},
          "completed_at": {"type": "string", "format": "date-time"},
          "ephemeral": {"const": true},
          "transcripts_forwarded": {"const": false}
        }
      }
    }
  }
}
